{
  "permissions": {
    "deny": [
      "Read(./.claude/worktrees/**)",
      "Read(./.history/**)",
      "Read(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.mypy_cache/**)",
      "Read(**/.pytest_cache/**)",
      "Read(**/.ruff_cache/**)",
      "Read(./frontend/dist/**)",
      "Read(**/uv.lock)",
      "Read(**/package-lock.json)",
      "Read(./.env)",
      "Read(./.env.bak*)",
      "Read(./frontend/.env)",
      "Read(**/.geocode_cache.json)",
      "Read(./.playwright-mcp/**)",
      "Read(./supabase/.temp/**)",
      "Read(**/logs/**)",
      "Read(**/*.jsonl)",
      "Read(**/*.png)",
      "Read(**/*.jpg)",
      "Read(**/*.jpeg)",
      "Read(**/*.gif)",
      "Read(**/*.ico)",
      "Read(**/*.webp)",
      "Read(**/*.woff)",
      "Read(**/*.woff2)",
      "Read(**/*.ttf)",
      "Read(**/*.pdf)"
      "Read(./docs/pm-log.jsonl)",
      "Read(**/*.lock)"
    ]
  },
  "hooks": { 
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{ f=$(python -c \"import sys,json;print(json.load(sys.stdin).get('tool_input',{}).get('file_path',''))\"); case \"$f\" in *.py) ruff format \"$f\";; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting with ruff..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "evals-skills@hamelsmu-evals-skills": true
  }
}