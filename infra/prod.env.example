# The production env file — a TEMPLATE, never filled in here.
# On the server it lives at /srv/vaivia/.env (chmod 600, owner deploy); on the
# laptop beta anywhere outside the repo, passed as --env-file and
# VAIVIA_ENV_FILE (docs/deploy.md). Values come from the password manager.
#
# Not here on purpose: NODE_ENV, VAIVIA_ENV, NEO4J_URI, BACKEND_URL,
# GATEWAY_HOST, PACK_DIR, REQUIRE_PACK, ROUTE_DOCUMENTS_DIR and
# GATEWAY_DEV_NO_AUTH. compose.prod.yml sets the first eight itself, and
# infra/deploy.sh refuses to run if any of them — or the auth switch — is here.

# ─── Secrets ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GATEWAY_SHARED_SECRET=            # openssl rand -hex 32; the backend refuses to boot without it
NEO4J_PASSWORD=                   # production-only
POSTGIS_PASSWORD=                 # production-only
# Hosted Supabase, session-mode pooler (the direct host is IPv6-only).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# ─── Supabase (hosted project) ───────────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_JWT_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# ─── Front door ──────────────────────────────────────────────────────────────
# caddy (a server with a domain) | tunnel (named Cloudflare Tunnel, needs the
# domain) | tunnel-quick (random *.trycloudflare.com address, the laptop beta)
FRONT_DOOR=tunnel-quick
# Where the frontend is served from — the gateway refuses every other origin.
# Laptop beta: the Pages address. With a domain: https://<domain>.
ALLOWED_ORIGINS=https://<project>.pages.dev
# Profile `caddy` only: api.<domain> (or localhost for a laptop check).
SITE_ADDRESS=
# Profile `tunnel` only (a named tunnel, once the domain exists).
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Data on the host (defaults are the server's /srv/vaivia layout) ─────────
#PACK_HOST_DIR=/srv/vaivia/data/packs/current
#PACKS_HOST_DIR=/srv/vaivia/data/packs
#DOCUMENTS_HOST_DIR=/srv/vaivia/data/documents
#MIGRATIONS_HOST_DIR=/srv/vaivia/migrations
# The file itself, so the services read the same values compose interpolates.
#VAIVIA_ENV_FILE=/srv/vaivia/.env

# ─── Images ──────────────────────────────────────────────────────────────────
IMAGE_TAG=main
#IMAGE_REGISTRY=ghcr.io/ai-safe-earth

# ─── Limits (optional; the defaults are in code) ─────────────────────────────
#DAILY_TOKEN_QUOTA_PER_USER=50000
#RATE_LIMIT_MAX=
#RATE_LIMIT_WINDOW_MS=
