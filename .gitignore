# Environment
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
dist/
build/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb
# ...except the pipeline's state notebook, which is a REVIEW SURFACE rather
# than someone's scratch pad: it is committed with its outputs so the state of
# the build reads on GitHub without a database.
!pipeline/notebooks/*.ipynb
# The HTML export is not committed. GitHub renders the .ipynb with its outputs,
# which is the whole reason that file is exempt above, so the export bought
# nothing but 1.8 MB and a second copy to go stale. Regenerate it locally when
# you want one offline: jupyter nbconvert --to html pipeline/notebooks/state.ipynb
pipeline/notebooks/*.html

# OSM / data files (can be large)
*.osm
*.osm.pbf
*.geojson

# Ingestion caches (auto-generated, not committed)
backend/fixtures/trailforks_cache/
backend/fixtures/overpass_cache/

# Neo4j local data (if running outside Docker)
neo4j/data/
neo4j/logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
# Local History extension: a full copy of every edit, one git add -A from
# being committed.
.history/

# macOS
.DS_Store

# Windows
desktop.ini

# Logs
*.log
logs/

# Supabase local JWT signing keys. These are private keys: the local stack signs
# every access token with them, so a leak forges a session against any stack
# that trusts the matching JWKS.
infra/supabase/signing_keys.json
**/signing_keys*.json

# Pipeline source downloads (large, reproducible from the URLs in sources/)
pipeline/data/

# Review bundles: exported snapshots of PostGIS layers, rebuildable with
# `uv run python -m export.review_bundle --zip`. The database is the product.
/review/
/review.zip

# Personal working note, not part of the repo.
Oscar_continua_desde_aqui.md

# A local pin of the Neo4j GDS jar (64 MB), kept so a container recreate can
# seed the neo4j_plugins volume without reaching graphdatascience.ninja.
# See CONTRIBUTING "Neo4j plugins" and docs/fragilities.md #16.
infra/neo4j/plugins/

# Browser-automation debris (playwright MCP)
.playwright-mcp/
