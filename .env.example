# get-out-door environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# ─── Ingestion ───────────────────────────────────────────────────────────────
# Default bounding box (minLat,minLon,maxLat,maxLon) — adjust per region
DEFAULT_BBOX=45.8,9.3,46.0,9.6

# Threshold in metres for spatial proximity matching (OSM <-> Trailforks)
SPATIAL_MATCH_THRESHOLD_M=20

# Threshold in metres for PASSES_BY relationship (Segment <-> POI)
PASSES_BY_THRESHOLD_M=50

# ─── Trailforks ──────────────────────────────────────────────────────────────
TRAILFORKS_API_KEY=your-api-key-here
TRAILFORKS_BASE_URL=https://www.trailforks.com/api/1

# ─── OpenAI (intent extraction + embeddings) ─────────────────────────────────
OPENAI_API_KEY=your-openai-key-here
INTENT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─── Supabase (auth JWKS + Postgres: chat history, quotas, cost ledger) ──────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend only, never the frontend
SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ─── Backend API (internal; only the gateway is public) ──────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
GATEWAY_SHARED_SECRET=generate-a-long-random-string   # backend rejects requests without it

# ─── Gateway (the only publicly exposed service) ─────────────────────────────
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Supabase Postgres connection string; unset disables LLM quota enforcement
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DAILY_TOKEN_QUOTA_PER_USER=50000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=120000

# ─── Frontend (frontend/.env.local — NEXT_PUBLIC_* ships to the browser) ─────
# Only ever put public values here. The Supabase service-role key and the
# OpenAI key are backend-only and must never appear in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
